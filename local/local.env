# Local development runtime (ADR-001). Development-only values for one MacBook.
# Nothing here is a production credential. Values can be overridden from the
# environment, which the reset guards rely on to refuse unsafe targets.
: "${BEE_COMPOSE_PROJECT:=bee-local}"
: "${BEE_WEB_PORT:=3100}"
: "${BEE_API_PORT:=8090}"
: "${BEE_KC_PORT:=8180}"
: "${BEE_PG_PORT:=5434}"
: "${BEE_APP_DB:=bee_app}"
: "${BEE_APP_DB_USER:=bee_app}"
: "${BEE_APP_DB_PASSWORD:=bee-local-app}"
: "${BEE_MAINT_DB_USER:=bee_local_maint}"
: "${BEE_MAINT_DB_PASSWORD:=bee-local-maint}"
: "${BEE_KC_DB_PASSWORD:=bee-local-kc}"
: "${BEE_PG_SUPER_PASSWORD:=bee-local-super}"
: "${BEE_KC_ADMIN_PASSWORD:=bee-local-admin}"
: "${BEE_REALM:=bee-local}"
: "${BEE_DEV_USER_PASSWORD:=bee-local-dev}"
: "${BEE_API_HEAP:=-Xms128m -Xmx512m}"
# Keycloak client used by the Next.js server for sign-in (WP02.1); server-side only.
: "${BEE_WEB_CLIENT_ID:=bee-web}"
: "${BEE_WEB_CLIENT_SECRET:=bee-local-web-secret}"
export BEE_COMPOSE_PROJECT BEE_WEB_PORT BEE_API_PORT BEE_KC_PORT BEE_PG_PORT BEE_APP_DB BEE_APP_DB_USER \
  BEE_APP_DB_PASSWORD BEE_MAINT_DB_USER BEE_MAINT_DB_PASSWORD BEE_KC_DB_PASSWORD BEE_PG_SUPER_PASSWORD BEE_KC_ADMIN_PASSWORD BEE_REALM \
  BEE_DEV_USER_PASSWORD BEE_API_HEAP BEE_WEB_CLIENT_ID BEE_WEB_CLIENT_SECRET
