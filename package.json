{
  "name": "bee-sl-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "audit:access": "bash scripts/access-audit.sh",
    "matrix": "bash scripts/screen-matrix.sh",
    "local:up": "bash scripts/local/up.sh",
    "local:health": "bash scripts/local/health.sh",
    "local:seed": "bash scripts/local/seed.sh",
    "local:reset": "bash scripts/local/reset.sh",
    "local:reset:identity": "bash scripts/local/reset-identity.sh",
    "local:check": "bash scripts/local/check.sh",
    "local:down": "bash scripts/local/down.sh",
    "local:destroy": "bash scripts/local/destroy.sh",
    "local:rt1": "bash scripts/local/rt1-proof.sh",
    "local:auth": "bash -c 'source scripts/local/lib.sh && node scripts/local/auth-check.cjs --with-expiry'",
    "local:access": "bash -c 'source scripts/local/lib.sh && node scripts/local/access-check.cjs'",
    "local:browser": "bash -c 'source scripts/local/lib.sh && node scripts/local/browser-check.cjs'",
    "local:read-ui": "bash -c 'source scripts/local/lib.sh && node scripts/local/read-ui-browser-check.cjs'",
    "local:model-drafts": "bash -c 'source scripts/local/lib.sh && node scripts/local/model-drafts-browser-check.cjs'",
    "local:model-submit": "bash -c 'source scripts/local/lib.sh && node scripts/local/model-submit-browser-check.cjs'",
    "local:model-documents": "bash -c 'source scripts/local/lib.sh && node scripts/local/model-documents-browser-check.cjs'",
    "api:test:submit": "JAVA_HOME=$(/usr/libexec/java_home -v 17) mvn -q -B -f backend/pom.xml test -Dtest=ModelApplicationSubmitDatabaseTest -Dgroups=db -Dbee.test.excludedGroups=none -Dsurefire.failIfNoSpecifiedTests=false",
    "api:test:documents": "JAVA_HOME=$(/usr/libexec/java_home -v 17) mvn -q -B -f backend/pom.xml test -Dtest=ModelApplicationDocumentDatabaseTest -Dgroups=db -Dbee.test.excludedGroups=none -Dsurefire.failIfNoSpecifiedTests=false",
    "local:mfa": "bash -c 'source scripts/local/lib.sh && node scripts/local/mfa-check.cjs'",
    "local:mfa:misbind": "bash -c 'source scripts/local/lib.sh && node scripts/local/mfa-misbind-check.cjs'",
    "local:contract": "bash -c 'source scripts/local/lib.sh && node scripts/local/contract-check.cjs'",
    "local:bff": "bash -c 'source scripts/local/lib.sh && node scripts/local/bff-check.cjs --with-expiry'",
    "local:coverage": "node scripts/local/contract-coverage.cjs",
    "local:wp033": "bash -c 'source scripts/local/lib.sh && set +e && export CONTRACT_OBSERVED=\"$RUN_DIR/contract-observed.jsonl\" && : > \"$CONTRACT_OBSERVED\" && node scripts/local/contract-check.cjs; c=$?; node scripts/local/bff-check.cjs --with-expiry; b=$?; node scripts/local/contract-coverage.cjs; v=$?; exit $((c || b || v))'",
    "web:test": "node --import ./scripts/local/test-resolve.mjs --test scripts/local/oidc.test.mjs scripts/local/api-contract.test.mjs scripts/local/contract-artifact.test.mjs scripts/local/request-log.test.mjs scripts/local/read-ui.test.mjs",
    "api:test": "JAVA_HOME=$(/usr/libexec/java_home -v 17) mvn -q -B -f backend/pom.xml test",
    "api:test:masters": "JAVA_HOME=$(/usr/libexec/java_home -v 17) mvn -q -B -f backend/pom.xml test -Dgroups=db -Dbee.test.excludedGroups=none -Dsurefire.failIfNoSpecifiedTests=false",
    "api:test:brand-auth": "JAVA_HOME=$(/usr/libexec/java_home -v 17) mvn -q -B -f backend/pom.xml test -Dtest=BrandAuthDatabaseTest -Dgroups=db -Dbee.test.excludedGroups=none -Dsurefire.failIfNoSpecifiedTests=false"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
